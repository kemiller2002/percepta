{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echelonfoundry.com/schemas/percepta-repository-doctor/v1",
  "title": "Percepta Repository Doctor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "component",
    "healthy",
    "findings"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "component": {
      "const": "percepta"
    },
    "healthy": {
      "type": "boolean"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "detail"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^PERCEPTA-REPO-[A-Z0-9-]+$"
          },
          "detail": {
            "type": "string"
          },
          "remediation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
