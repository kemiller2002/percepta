{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echelonfoundry.com/schemas/percepta-evidence.schema.json",
  "title": "Percepta Experiment Evidence Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "experimentId", "runId", "createdAt",
    "repository", "sourceRevision",
    "inputDigest", "inputDigestAlgorithm", "inputs",
    "configurationDigest", "configurationDigestAlgorithm", "configuration",
    "artifact", "dependencies",
    "outcome", "evaluationResults", "evidenceReferences",
    "evidenceDigest", "evidenceDigestAlgorithm",
    "screen", "contractSha256", "generatedAtUtc", "complete", "results"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "experimentId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "format": "uuid" },
    "createdAt": { "type": "string", "format": "date-time" },
    "repository": { "type": "string", "minLength": 1 },
    "sourceRevision": { "$ref": "#/$defs/sourceRevision" },
    "inputDigest": { "$ref": "#/$defs/sha256" },
    "inputDigestAlgorithm": { "const": "sha-256" },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/inputIdentity" }
    },
    "configurationDigest": { "$ref": "#/$defs/sha256" },
    "configurationDigestAlgorithm": { "const": "sha-256" },
    "configuration": { "$ref": "#/$defs/configuration" },
    "artifact": { "$ref": "#/$defs/artifactIdentity" },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/dependencyIdentity" }
    },
    "outcome": { "enum": ["satisfied", "not-satisfied"] },
    "evaluationResults": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evaluationResult" }
    },
    "evidenceReferences": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidenceReference" }
    },
    "evidenceDigest": { "$ref": "#/$defs/sha256" },
    "evidenceDigestAlgorithm": { "const": "sha-256" },
    "screen": { "type": "string", "minLength": 1 },
    "contractSha256": { "$ref": "#/$defs/sha256" },
    "generatedAtUtc": { "type": "string", "format": "date-time" },
    "complete": { "type": "boolean" },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evaluationResult" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourceRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "inputIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "digest", "digestAlgorithm"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/sha256" },
        "digestAlgorithm": { "const": "sha-256" }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractReference", "contractSha256", "updateBaselines"],
      "properties": {
        "contractReference": { "type": "string", "minLength": 1 },
        "contractSha256": { "$ref": "#/$defs/sha256" },
        "updateBaselines": { "type": "boolean" }
      }
    },
    "artifactIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactName", "artifactVersion", "artifactSourceRevision",
        "artifactDigest", "artifactDigestAlgorithm"
      ],
      "properties": {
        "artifactName": { "type": "string", "minLength": 1 },
        "artifactVersion": { "type": "string", "minLength": 1 },
        "artifactSourceRevision": { "$ref": "#/$defs/sourceRevision" },
        "artifactDigest": { "$ref": "#/$defs/sha256" },
        "artifactDigestAlgorithm": { "const": "sha-256" }
      }
    },
    "dependencyIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependencyName", "dependencyVersion"],
      "dependentRequired": {
        "dependencyDigest": ["dependencyDigestAlgorithm"],
        "dependencyDigestAlgorithm": ["dependencyDigest"]
      },
      "properties": {
        "dependencyName": { "type": "string", "minLength": 1 },
        "dependencyVersion": { "type": "string", "minLength": 1 },
        "dependencyDigest": { "$ref": "#/$defs/sha256" },
        "dependencyDigestAlgorithm": { "const": "sha-256" }
      }
    },
    "evaluationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement", "kind", "required", "status",
        "summary", "source", "evidenceReferences"
      ],
      "properties": {
        "requirement": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "contract-validation", "structural", "state-projection",
            "interaction", "accessibility", "responsive",
            "visual-regression", "semantic-visual-review", "accepted-deviation"
          ]
        },
        "required": { "type": "boolean" },
        "status": {
          "enum": ["Passed", "Failed", "Unavailable", "NotApplicable", "AcceptedDeviation"]
        },
        "reason": { "type": "string" },
        "summary": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "evidenceReferences": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sourceRevision", "digest", "digestAlgorithm"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sourceRevision": { "$ref": "#/$defs/sourceRevision" },
        "digest": { "$ref": "#/$defs/sha256" },
        "digestAlgorithm": { "const": "sha-256" }
      }
    }
  }
}
